{
  "name": "gabai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GabAI: city service roadmaps from official Citizen's Charters",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "chat": "tsx cli/chat.ts",
    "dev": "wrangler dev",
    "kb:build": "cd knowledge && python -I tools/build_phase0.py && python -I tools/validate.py && python -I tools/build_reference.py && cd .. && npm run search:build",
    "search:build": "tsx scripts/build-search-index.ts",
    "search": "tsx scripts/search.ts",
    "ai:ping": "tsx scripts/ping-ai.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.86",
    "ai": "^7.0.179",
    "hono": "^4.13.20",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
